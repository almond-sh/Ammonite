val isMasterCommit =
  sys.env.get("GITHUB_REPOSITORY").contains(s"$ghOrg/$ghRepo") &&
    sys.env.get("GITHUB_REF").exists(x => x.endsWith(s"/$masterBranch"))

val latestTaggedVersion =
  try {
    os.proc("git", "describe", "--abbrev=0", "--tags").call().out.trim()
  } catch {
    case e: os.SubprocessException =>
      "dev"
  }

val gitHead = os.proc("git", "rev-parse", "HEAD").call().out.trim()

val scala2_12Versions = 8.to(21)
  .map(v => s"2.12.$v")
val scala2_13Versions = 3.to(18)
  .map(v => s"2.13.$v")

val scala3Lts = "3.3.8"
val scala3Latest = "3.8.4"

val scala2Versions = scala2_12Versions ++ scala2_13Versions
val scala3Versions = Seq(scala3Lts, scala3Latest)

// Modules that aren't cross-published for full Scala versions are built once per binary Scala
// version, with the oldest Scala version we support for it: Scala 2 patch releases are only
// forward binary compatible, so building with 2.13.3 gives us artifacts that all the 2.13.x
// versions we support can run, while building with 2.13.18 wouldn't. Likewise, TASTy files
// written by the Scala 3 LTS can be read by all the later Scala 3 versions we support.
val binCrossScalaVersions =
  Seq(scala2_12Versions.head, scala2_13Versions.head, scala3Lts)
/**
 * The Scala versions we test a binary cross-published module instance against.
 *
 * Modules other than `amm.compiler` are built once per binary Scala version, but their test
 * suites have to run against every compiler we support, so the test modules are cross-built
 * over these instead.
 */
def fullScalaVersionsFor(binaryCrossScalaVersion: String): Seq[String] =
  if (binaryCrossScalaVersion.startsWith("2.12.")) scala2_12Versions
  else if (binaryCrossScalaVersion.startsWith("2.13.")) scala2_13Versions
  else scala3Versions

/** The [[binCrossScalaVersions]] entry a full Scala version's modules are built under. */
def binCrossScalaVersionFor(fullScalaVersion: String): String =
  binCrossScalaVersions
    .find(v => fullScalaVersionsFor(v).contains(fullScalaVersion))
    .getOrElse(sys.error(s"No binary cross Scala version for $fullScalaVersion"))

val assemblyCrossScalaVersions = Seq(
  scala2_12Versions.last,
  scala2_13Versions.last,
  scala3Lts,
  scala3Latest
)
def isScala2_12_10OrLater(sv: String): Boolean = {
  (sv.startsWith("2.12.") && sv.stripPrefix("2.12.").length > 1) || sv.startsWith("2.13.")
}
val fullCrossScalaVersions = scala2Versions ++ scala3Versions

/**
 * A source directory of `amm.compiler.internal`, and the full Scala versions it is written for.
 *
 * The classes in it are named after the directory - `scala-2.13.12+` holds `ReporterMaker2_13_12`,
 * `scala-2.12.0-2.12.12` holds `ReporterMaker2_12_0__2_12_12` - so that the implementations for
 * all the patch versions of a binary Scala version can sit side by side in a single
 * `ammonite-compiler` JAR, which picks between them at run time from the compiler it finds on
 * its class path.
 *
 * @param name the directory name, under `amm/compiler/internal/src/main`
 * @param interfaces the `amm.compiler.interfaces` traits it implements, one class per trait
 * @param covers whether it is written for a given full Scala version
 */
case class CompilerInternalDir(name: String, interfaces: Seq[String], covers: String => Boolean) {

  /** The suffix the names of the classes in this directory end with. */
  def classNameSuffix: String =
    name.stripPrefix("scala-").stripSuffix("+").replace("-", "__").replace(".", "_")

  /**
   * The full Scala versions this directory is compiled with - the oldest one we support for
   * each binary Scala version it covers, so that its classes run on all the other ones.
   */
  def scalaVersions: Seq[String] =
    binCrossScalaVersions.flatMap(fullScalaVersionsFor(_).find(covers))
}

/**
 * The source directories of `amm.compiler.internal`.
 *
 * Each one holds the implementations, for one interval of Scala versions, of some of the
 * interfaces `amm.compiler.interfaces` defines - the parts of Ammonite that have to follow
 * the Scala compiler's internals from one patch release to the next.
 */
val compilerInternalDirs: Seq[CompilerInternalDir] = {
  def patchOf(sv: String, prefix: String) = sv.stripPrefix(prefix).toInt
  def is2_12(sv: String) = sv.startsWith("2.12.")
  def is2_13(sv: String) = sv.startsWith("2.13.")
  Seq(
    // ReporterMaker: scalac's reporters were rewritten in 2.12.13 / 2.13.1 (AbstractReporter
    // gave way to FilteringReporter), and doReport took an extra List[CodeAction] in 2.13.12
    CompilerInternalDir(
      "scala-2.12.0-2.12.12",
      Seq("ReporterMaker"),
      sv => is2_12(sv) && patchOf(sv, "2.12.") <= 12
    ),
    CompilerInternalDir(
      "scala-2.12.13-2.13.11",
      Seq("ReporterMaker"),
      sv =>
        (is2_12(sv) && patchOf(sv, "2.12.") >= 13) || (is2_13(sv) && patchOf(sv, "2.13.") <= 11)
    ),
    CompilerInternalDir(
      "scala-2.13.12+",
      Seq("ReporterMaker"),
      sv => is2_13(sv) && patchOf(sv, "2.13.") >= 12
    ),
    // GlobalMaker: 2.12 has to subclass the analyzer to get Ammonite's macro class loader in,
    // and a subclass of that trait only links against a scalac that declares no typechecker
    // field it does not already set - 2.12.9 added some, and 2.12.13 dropped the need for an
    // interactive analyzer of our own. 2.13 needs no analyzer of its own at all.
    CompilerInternalDir(
      "scala-2.12.0-2.12.8",
      Seq("GlobalMaker", "ClassPathMaker"),
      sv => is2_12(sv) && patchOf(sv, "2.12.") <= 8
    ),
    CompilerInternalDir(
      "scala-2.12.9-2.12.12",
      Seq("GlobalMaker"),
      sv => is2_12(sv) && patchOf(sv, "2.12.") >= 9 && patchOf(sv, "2.12.") <= 12
    ),
    CompilerInternalDir(
      "scala-2.12.13+",
      Seq("GlobalMaker"),
      sv => is2_12(sv) && patchOf(sv, "2.12.") >= 13
    ),
    CompilerInternalDir("scala-2.13", Seq("GlobalMaker"), is2_13),
    // SymbolOps: Symbol.isPackage was declared by HasFlags until 2.13.17 moved it
    CompilerInternalDir("scala-2.12", Seq("SymbolOps"), is2_12),
    CompilerInternalDir(
      "scala-2.13.0-2.13.16",
      Seq("SymbolOps"),
      sv => is2_13(sv) && patchOf(sv, "2.13.") <= 16
    ),
    CompilerInternalDir(
      "scala-2.13.17+",
      Seq("SymbolOps"),
      sv => is2_13(sv) && patchOf(sv, "2.13.") >= 17
    ),
    // ClassPathMaker: ZipAndJarClassPathFactory.create takes a CloseableRegistry since 2.12.9,
    // and scalac's ClassPath methods take a PackageName rather than a String since 2.12.10
    // (the 2.12.0-2.12.8 variant lives in the directory the GlobalMaker one is in)
    CompilerInternalDir("scala-2.12.9", Seq("ClassPathMaker"), _ == "2.12.9"),
    CompilerInternalDir(
      "scala-2.12.10-2.13",
      Seq("ClassPathMaker"),
      sv => (is2_12(sv) && patchOf(sv, "2.12.") >= 10) || is2_13(sv)
    ),
    // CompilationUnitMaker: CompilationUnit takes an extra parameter since 3.4.2
    CompilerInternalDir(
      "scala-3.0.0-3.4.1",
      Seq("CompilationUnitMaker"),
      sv => isScala3(sv) && Version(sv) < Version("3.4.2")
    ),
    CompilerInternalDir(
      "scala-3.4.2+",
      Seq("CompilationUnitMaker"),
      sv => isScala3(sv) && Version(sv) >= Version("3.4.2")
    ),
    // GivenNames: desugar.inventGivenOrExtensionName was renamed to inventGivenName in 3.5.0
    CompilerInternalDir(
      "scala-3.0.0-3.4",
      Seq("GivenNames"),
      sv => isScala3(sv) && Version(sv) < Version("3.5.0")
    ),
    CompilerInternalDir(
      "scala-3.5.0+",
      Seq("GivenNames"),
      sv => isScala3(sv) && Version(sv) >= Version("3.5.0")
    ),
    // MessageRenderer and TermRefNames: 3.8.2 dropped MessageRendering.inlinePosStack, and
    // changed what NamedType.designator returns
    CompilerInternalDir(
      "scala-3.0.0-3.8.1",
      Seq("MessageRenderer", "TermRefNames"),
      sv => isScala3(sv) && Version(sv) < Version("3.8.2")
    ),
    CompilerInternalDir(
      "scala-3.8.2+",
      Seq("MessageRenderer", "TermRefNames"),
      sv => isScala3(sv) && Version(sv) >= Version("3.8.2")
    ),
    // CompletionMaker: dotty's Completion.Completer took over the whole tree path in 3.7.0
    CompilerInternalDir(
      "scala-3.0.0-3.6",
      Seq("CompletionMaker"),
      sv => isScala3(sv) && Version(sv) < Version("3.7.0")
    ),
    CompilerInternalDir(
      "scala-3.7+",
      Seq("CompletionMaker"),
      sv => isScala3(sv) && Version(sv) >= Version("3.7.0")
    )
  )
}

/** The `amm.compiler.internal` source directories `scalaVersion` compiles. */
def compilerInternalDirsFor(scalaVersion: String): Seq[String] =
  compilerInternalDirs.filter(_.scalaVersions.contains(scalaVersion)).map(_.name)

/**
 * The `ammonite.compiler.internal.CompilerInternals` source of the `amm.compiler` instance
 * for `binaryScalaVersion`, which hands out the [[compilerInternalDirs]] implementations
 * written for the compiler it finds at run time.
 */
def compilerInternalsSource(binaryScalaVersion: String): String = {
  val supported = fullScalaVersionsFor(binaryScalaVersion)
  val accessors = compilerInternalDirs
    .flatMap(dir => dir.interfaces.map(_ -> dir))
    .groupBy(_._1)
    .map {
      case (interface, dirs) =>
        val variants = dirs
          .flatMap { case (_, dir) => supported.find(dir.covers).map(_ -> dir.classNameSuffix) }
          .sortWith { case ((a, _), (b, _)) => Version(a) < Version(b) }
        interface -> variants
    }
    .filter { case (_, variants) => variants.nonEmpty }
    .toSeq
    .sortBy { case (interface, _) => interface }
    .map {
      case (interface, variants) =>
        val name = interface.head.toLower +: interface.tail
        val entries = variants
          .map { case (since, suffix) => s"""      "$since" -> "$suffix"""" }
          .mkString(",\n")
        s"""  lazy val $name: $interface =
           |    InternalsLoader.load(
           |      classOf[$interface],
           |      compilerVersion,
           |$entries
           |    )""".stripMargin
    }
  val compilerClass =
    if (isScala3(binaryScalaVersion)) "classOf[dotty.tools.dotc.Driver]"
    else "classOf[scala.tools.nsc.Global]"
  s"""package ammonite.compiler.internal
     |
     |/**
     | * The `ammonite.compiler.internal` implementations written for the Scala compiler that
     | * `ammonite-compiler` finds on its class path.
     | *
     | * Generated by mill, from `compilerInternalDirs` in build.mill.
     | */
     |object CompilerInternals {
     |
     |  private lazy val compilerVersion =
     |    InternalsLoader.compilerVersion($compilerClass)
     |
     |${accessors.mkString("\n\n")}
     |}
     |""".stripMargin
}

def ciScalaVersions = Task {
  def entries(versions: Seq[String], includeMiddle: Boolean) = {
    val selected =
      if (includeMiddle) Seq(versions.head, versions(versions.length / 2), versions.last)
      else Seq(versions.head, versions.last)
    selected.map(version =>
      Map(
        "scala-version" -> version,
        "binary-scala-version" -> binCrossScalaVersionFor(version)
      )
    )
  }

  val allEntries =
    entries(scala2_12Versions, includeMiddle = true) ++
      entries(scala2_13Versions, includeMiddle = true) ++
      entries(scala3Versions, includeMiddle = false)

  // The terminal module is cross-built for binCrossScalaVersions only, and its tests
  // don't depend on the Scala version of the matrix entry - only run them from one entry.
  val withTerminalFlag = allEntries.zipWithIndex.map {
    case (entry, idx) =>
      entry + ("test-terminal" -> (idx == 0).toString)
  }

  Map("include" -> withTerminalFlag)
}

val latestAssemblies = assemblyCrossScalaVersions.map(shell(_).assembly)

println("GITHUB REF " + sys.env.get("GITHUB_REF"))

def latestVersionTag(commit: Option[String] = None) =
  scala.util.Try(
    os.proc(
      "git",
      "describe",
      "--abbrev=0",
      "--tags",
      "--match",
      "v*",
      commit.toSeq
    ).call().out.trim()
  ).toOption

val headVersionTag = scala.util.Try(
  os.proc("git", "describe", "--exact-match", "--tags", "--match", "v*", gitHead)
    .call()
    .out
    .trim()
).toOption

val ciTag =
  if (sys.env.contains("CI"))
    sys.env.get("GITHUB_REF").collect {
      case ref if ref.startsWith("refs/tags/") => ref.stripPrefix("refs/tags/")
    }
  else None

val publishVersion = {
  val tagOpt = headVersionTag match {
    case Some(tag) if sys.env.contains("CI") && !ciTag.contains(tag) =>
      latestVersionTag(Some(s"$gitHead^"))
    case _ => latestVersionTag()
  }
  tagOpt match {
    case None => "3.0.10-SNAPSHOT"
    case Some(tag) =>
      // v3.0.10_sv2.12.8_sv3.3.8 publishes as Maven version 3.0.10
      val version = tag.stripPrefix("v").takeWhile(_ != '_')
      if (headVersionTag.contains(tag) && (!sys.env.contains("CI") || ciTag.contains(tag))) version
      else {
        val components = version.split('.').toSeq
        (components.init :+ (components.last.toInt + 1)).mkString(".") + "-SNAPSHOT"
      }
  }
}

val isUnstableBuild = publishVersion.endsWith("-SNAPSHOT")

def emptyDocJar: T[PathRef] = Task {
  val jar = Task.dest / "out.jar"
  val zip = new java.util.zip.ZipOutputStream(java.nio.file.Files.newOutputStream(jar.toNIO))
  zip.close()
  PathRef(jar)
}

