val ghOrg = "com-lihaoyi"
val ghRepo = "Ammonite"
val masterBranch = "main"
val publishBranches = Seq(masterBranch, "2.x")
val homePage = "https://ammonite.io"

val isMasterCommit =
  sys.env.get("GITHUB_REPOSITORY").contains(s"$ghOrg/$ghRepo") &&
    sys.env.get("GITHUB_REF").exists(x => x.endsWith(s"/$masterBranch"))

val latestTaggedVersion =
  try {
    os.proc("git", "describe", "--abbrev=0", "--tags").call().out.trim()
  } catch {
    case e: os.SubprocessException =>
      "dev"
  }

val gitHead = os.proc("git", "rev-parse", "HEAD").call().out.trim()

val scala2_12Versions = 8.to(21)
  .map(v => s"2.12.$v")
val scala2_13Versions = 3.to(18)
  .map(v => s"2.13.$v")

val scala3Lts = "3.3.8"
val scala3Latest = "3.8.4"

val scala2Versions = scala2_12Versions ++ scala2_13Versions
val scala3Versions = Seq(scala3Lts, scala3Latest)

// Modules that aren't cross-published for full Scala versions are built once per binary Scala
// version, with the oldest Scala version we support for it: Scala 2 patch releases are only
// forward binary compatible, so building with 2.13.3 gives us artifacts that all the 2.13.x
// versions we support can run, while building with 2.13.18 wouldn't. Likewise, TASTy files
// written by the Scala 3 LTS can be read by all the later Scala 3 versions we support.
val binCrossScalaVersions =
  Seq(scala2_12Versions.head, scala2_13Versions.head, scala3Lts)
/**
 * The Scala versions we test a binary cross-published module instance against.
 *
 * Modules other than `amm.compiler` are built once per binary Scala version, but their test
 * suites have to run against every compiler we support, so the test modules are cross-built
 * over these instead.
 */
def fullScalaVersionsFor(binaryCrossScalaVersion: String): Seq[String] =
  if (binaryCrossScalaVersion.startsWith("2.12.")) scala2_12Versions
  else if (binaryCrossScalaVersion.startsWith("2.13.")) scala2_13Versions
  else scala3Versions

/** The [[binCrossScalaVersions]] entry a full Scala version's modules are built under. */
def binCrossScalaVersionFor(fullScalaVersion: String): String =
  binCrossScalaVersions
    .find(v => fullScalaVersionsFor(v).contains(fullScalaVersion))
    .getOrElse(sys.error(s"No binary cross Scala version for $fullScalaVersion"))

val assemblyCrossScalaVersions = Seq(
  scala2_12Versions.last,
  scala2_13Versions.last,
  scala3Lts,
  scala3Latest
)
def isScala2_12_10OrLater(sv: String): Boolean = {
  (sv.startsWith("2.12.") && sv.stripPrefix("2.12.").length > 1) || sv.startsWith("2.13.")
}
val fullCrossScalaVersions = scala2Versions ++ scala3Versions

def ciScalaVersions = Task {
  def entries(versions: Seq[String], includeMiddle: Boolean) = {
    val selected =
      if (includeMiddle) Seq(versions.head, versions(versions.length / 2), versions.last)
      else Seq(versions.head, versions.last)
    selected.map(version =>
      Map(
        "scala-version" -> version,
        "binary-scala-version" -> binCrossScalaVersionFor(version)
      )
    )
  }

  val allEntries =
    entries(scala2_12Versions, includeMiddle = true) ++
      entries(scala2_13Versions, includeMiddle = true) ++
      entries(scala3Versions, includeMiddle = false)

  // The terminal module is cross-built for binCrossScalaVersions only, and its tests
  // don't depend on the Scala version of the matrix entry - only run them from one entry.
  val withTerminalFlag = allEntries.zipWithIndex.map {
    case (entry, idx) =>
      entry + ("test-terminal" -> (idx == 0).toString)
  }

  Map("include" -> withTerminalFlag)
}

val latestAssemblies = assemblyCrossScalaVersions.map(shell(_).assembly)

println("GITHUB REF " + sys.env.get("GITHUB_REF"))

def latestVersionTag(commit: Option[String] = None) =
  scala.util.Try(
    os.proc(
      "git",
      "describe",
      "--abbrev=0",
      "--tags",
      "--match",
      "v*",
      commit.toSeq
    ).call().out.trim()
  ).toOption

val headVersionTag = scala.util.Try(
  os.proc("git", "describe", "--exact-match", "--tags", "--match", "v*", gitHead)
    .call()
    .out
    .trim()
).toOption

val ciTag =
  if (sys.env.contains("CI"))
    sys.env.get("GITHUB_REF").collect {
      case ref if ref.startsWith("refs/tags/") => ref.stripPrefix("refs/tags/")
    }
  else None

val publishVersion = {
  val tagOpt = headVersionTag match {
    case Some(tag) if sys.env.contains("CI") && !ciTag.contains(tag) =>
      latestVersionTag(Some(s"$gitHead^"))
    case _ => latestVersionTag()
  }
  tagOpt match {
    case None => "3.0.10-SNAPSHOT"
    case Some(tag) =>
      // v3.0.10_sv2.12.8_sv3.3.8 publishes as Maven version 3.0.10
      val version = tag.stripPrefix("v").takeWhile(_ != '_')
      if (headVersionTag.contains(tag) && (!sys.env.contains("CI") || ciTag.contains(tag))) version
      else {
        val components = version.split('.').toSeq
        (components.init :+ (components.last.toInt + 1)).mkString(".") + "-SNAPSHOT"
      }
  }
}

val isUnstableBuild = publishVersion.endsWith("-SNAPSHOT")

def emptyDocJar: T[PathRef] = Task {
  val jar = Task.dest / "out.jar"
  val zip = new java.util.zip.ZipOutputStream(java.nio.file.Files.newOutputStream(jar.toNIO))
  zip.close()
  PathRef(jar)
}

val fastparseVersion = "3.1.1"
val scalametaVersion = "4.15.2"

object Deps {
  // acyclic is published for each full Scala version, and no longer gets published
  // for the oldest Scala versions we support
  def acyclic(scalaVersion: String) = {
    val ver =
      if (Version(scalaVersion) < Version("2.12.9")) "0.3.14"
      else "0.3.21"
    mvn"com.lihaoyi:::acyclic:$ver"
  }
  val bcprovJdk15on = mvn"org.bouncycastle:bcprov-jdk18on:1.82"
  val cask = mvn"com.lihaoyi::cask:0.10.2"
  val classPathUtil = mvn"io.get-coursier::class-path-util:0.1.4"
  val coursierInterface = mvn"io.get-coursier:interface:1.0.28"
  val coursierDependencyInterface = mvn"io.get-coursier::dependency-interface:0.3.2"
  def coursierVersions(scalaVersion: String) = mvn"io.get-coursier::versions:0.5.2".withDottyCompat(scalaVersion)
  val fansi = mvn"com.lihaoyi::fansi:0.5.1"
  val fastparse = mvn"com.lihaoyi::fastparse:$fastparseVersion"
  val geny = mvn"com.lihaoyi::geny:1.1.1"
  val javaparserCore = mvn"com.github.javaparser:javaparser-core:3.2.12"
  val javassist = mvn"org.javassist:javassist:3.21.0-GA"
  val jlineJna = mvn"org.jline:jline-terminal-jna:3.14.1"
  val jlineReader = mvn"org.jline:jline-reader:3.14.1"
  val jlineTerminal = mvn"org.jline:jline-terminal:3.14.1"
  val jsch = mvn"com.jcraft:jsch:0.1.55"
  val mainargs = mvn"com.lihaoyi::mainargs:0.7.6"
  val osLib = mvn"com.lihaoyi::os-lib:0.11.5"
  val pprint = mvn"com.lihaoyi::pprint:0.9.0"
  val requests = mvn"com.lihaoyi::requests:0.9.0"
  val scalacheck = mvn"org.scalacheck::scalacheck:1.19.0"
  val scalaCollectionCompat = mvn"org.scala-lang.modules::scala-collection-compat:2.14.0"
  def scalaCompiler(scalaVersion: String) = mvn"org.scala-lang:scala-compiler:$scalaVersion"
  val scalaJava8Compat = mvn"org.scala-lang.modules::scala-java8-compat:1.0.2"
  val scalaparse = mvn"com.lihaoyi::scalaparse:$fastparseVersion"
  def scalaReflect(scalaVersion: String) = mvn"org.scala-lang:scala-reflect:$scalaVersion"
  def scalaXml(sv: String): Dep = {
    val ver =
      if (sv.startsWith("2.12.")) "1.3.0"
      else "2.0.1"
    mvn"org.scala-lang.modules::scala-xml:$ver"
  }
  val scalazCore = mvn"org.scalaz::scalaz-core:7.2.36"
  val semanticDbScalac = mvn"org.scalameta:::semanticdb-scalac:$scalametaVersion"
  val shapeless = mvn"com.chuusai::shapeless:2.3.3"
  val slf4jNop = mvn"org.slf4j:slf4j-nop:2.0.17"
  val sourcecode = mvn"com.lihaoyi::sourcecode:0.4.4"
  val typename = mvn"org.tpolecat::typename:1.1.0"
  val upickle = mvn"com.lihaoyi::upickle:4.3.2"

  val utest = mvn"com.lihaoyi::utest:0.9.1"
}

trait AmmInternalModule extends CrossSbtModule {
  // We need it to be a Boolean, not T[Boolean]
  def isCrossFullScalaVersion: Boolean = false
  def crossFullScalaVersion: T[Boolean] = Task { isCrossFullScalaVersion }
  def releaseVersion: T[String] = Task {
    if (Version(scalaVersion()) >= Version("3.8.0")) "17"
    else "11"
  }
  override def jvmVersion: T[String] = releaseVersion
  def artifactName: T[String] = Task {
    "ammonite-" + moduleSegments.parts.dropRight(1).mkString("-").stripPrefix("amm-")
  }
  def isScala2: T[Boolean] = Task { scalaVersion().startsWith("2.") }
  def scalacOptions: T[Seq[String]] = Task {
    val maybeAcyclicOptions =
      if (isScala2()) Seq("-P:acyclic:force")
      else Nil
    val releaseOptions = Seq("-release", releaseVersion())
    maybeAcyclicOptions ++ releaseOptions
  }
  def compileMvnDeps: T[Seq[Dep]] = Task {
    if (isScala2()) Seq(Deps.acyclic(scalaVersion()))
    else Seq[Dep]()
  }
  def scalacPluginMvnDeps: T[Seq[Dep]] = Task {
    if (isScala2()) Seq(Deps.acyclic(scalaVersion()))
    else Seq[Dep]()
  }
  override def scalaLibraryMvnDeps: T[Seq[Dep]] = Task {
    val scalaV = scalaVersion()
    val scalaO = scalaOrganization()
    if (isScala3(scalaV)) Seq(
      mvn"$scalaO::scala3-library:$scalaV"
    )
    else Seq(
      mvn"$scalaO:scala-library:$scalaV"
    )
  }
  trait AmmTests extends super.CrossSbtTests with TestModule.Utest {
    def mvnDeps: T[Seq[Dep]] = super.mvnDeps() ++ Seq(Deps.utest)
    def forkArgs: T[Seq[String]] = Seq("-Xmx2g", "-Dfile.encoding=UTF8")
    def testForkGrouping: T[Seq[Seq[String]]] = discoveredTestClasses().grouped(1).toSeq
    def testSandboxWorkingDir: T[Boolean] = false
  }
  def allBoundMvnDeps: T[Seq[BoundDep]] =
    Task { (allMvnDeps() ++ scalaLibraryMvnDeps()).map(bindDependency()) }

  def customSourceDirs: Seq[os.Path] = {
    val sv = crossScalaVersion
    def isScala2 = sv.startsWith("2.")
    def isScala3 = sv.startsWith("3.")
    val extraDir =
      if (sv.startsWith("2.12.")) {
        val patch = sv.stripPrefix("2.12.").takeWhile(_.isDigit).toInt
        val dirName0 = if (patch <= 8) "scala-2.12.0_8" else "scala-2.12.9+"
        val dirNames1 = if (patch <= 12) Seq("scala-2.12.0_12") else Nil
        val dirNames = Seq(dirName0) ++ dirNames1
        dirNames.map(dirName => moduleDir / "src" / "main" / dirName)
      } else
        Nil

    val extraDir2 =
      if (isScala2)
        Seq(
          if (isScala2_12_10OrLater(sv)) moduleDir / "src" / "main" / "scala-2.12.10-2.13.1+"
          else moduleDir / "src" / "main" / "scala-not-2.12.10-2.13.1+"
        )
      else Nil
    val extraDir3 =
      if (isScala2) {
        val dir =
          if (
            sv.startsWith("2.13.") && sv.stripPrefix("2.13.").toInt >= 1 && sv.stripPrefix(
              "2.13."
            ).toInt <= 11
          )
            moduleDir / "src" / "main" / "scala-2.13.1-2.13.11"
          else if (sv.startsWith("2.13.") && sv.stripPrefix("2.13.").toInt >= 12)
            moduleDir / "src" / "main" / "scala-2.13.12+"
          else if (sv.startsWith("2.12.") && sv.stripPrefix("2.12.").toInt >= 13)
            moduleDir / "src" / "main" / "scala-2.12.13+"
          else
            moduleDir / "src" / "main" / "scala-not-2.12.13+-2.13.1+"
        Seq(dir)
      } else Nil
    val extraDir4 =
      if (sv.startsWith("2.13.") || sv.startsWith("3."))
        Seq(moduleDir / "src" / "main" / "scala-2.13-or-3")
      else Nil
    val extraDir5 =
      if (Version(sv) >= Version("3.5.0"))
        Seq(moduleDir / "src" / "main" / "scala-3.5.0+")
      else if (Version(sv) >= Version("3.4.0") && Version(sv) < Version("3.4.2"))
        sys.error("Scala 3.4.0 and 3.4.1 are incompatible with Ammonite")
      else if (Version(sv) >= Version("3.4.2") && Version(sv) < Version("3.5.0"))
        Seq(moduleDir / "src" / "main" / "scala-3.4.2+")
      else if (Version(sv) >= Version("3.3.2") && Version(sv) < Version("3.4.0"))
        Seq(moduleDir / "src" / "main" / "scala-3.3.2+")
      else if (Version(sv) >= Version("3.0.0") && Version(sv) <= Version("3.3.1"))
        Seq(moduleDir / "src" / "main" / "scala-3.0.0-3.3.1")
      else Nil
    val extraDir6 =
      if (Version(sv) >= Version("3.0.0") && Version(sv) <= Version("3.3.5"))
        Seq(moduleDir / "src" / "main" / "scala-3.0.0-3.3.5")
      else if (Version(sv) >= Version("3.3.6") && Version(sv) < Version("3.4.0"))
        Seq(moduleDir / "src" / "main" / "scala-3.3.6+")
      else if (Version(sv) >= Version("3.4.0") && Version(sv) < Version("3.4.2"))
        Seq(moduleDir / "src" / "main" / "scala-3.4")
      else if (Version(sv) >= Version("3.5.0") && Version(sv) < Version("3.6.0"))
        Seq(moduleDir / "src" / "main" / "scala-3.5")
      else if (Version(sv) >= Version("3.6.0") && Version(sv) <= Version("3.6.2"))
        Seq(moduleDir / "src" / "main" / "scala-3.6.0-3.6.2")
      else if (Version(sv) >= Version("3.6.3") && Version(sv) < Version("3.7.0"))
        Seq(moduleDir / "src" / "main" / "scala-3.6.3+")
      else if (Version(sv) >= Version("3.7.0"))
        Seq(moduleDir / "src" / "main" / "scala-3.7+")
      else
        Nil
    val extraDir7 =
      if (Version(sv) >= Version("3.3.2") && Version(sv) <= Version("3.3.6"))
        Seq(moduleDir / "src" / "main" / "scala-3.3.2-3.3.6")
      else if (Version(sv) >= Version("3.3.7") && Version(sv) < Version("3.4.0"))
        Seq(moduleDir / "src" / "main" / "scala-3.3.7+")
      else
        Nil
    val extraDir8 =
      if (Version(sv) >= Version("3.5.0") && Version(sv) < Version("3.7.0"))
        Seq(moduleDir / "src" / "main" / "scala-3.5-3.6")
      else
        Nil
    val extraDir9 =
      if (Version(sv) == Version("3.3.7"))
        Seq(moduleDir / "src" / "main" / "scala-3.3.7")
      else if (Version(sv) >= Version("3.3.8") && Version(sv) < Version("3.4.0"))
        Seq(moduleDir / "src" / "main" / "scala-3.3.8+")
      else
        Nil

    val extraDirs: Seq[os.Path] =
      extraDir ++ extraDir2 ++ extraDir3 ++ extraDir4 ++ extraDir5 ++ extraDir6 ++ extraDir7 ++ extraDir8 ++ extraDir9

    extraDirs
  }

  def customSources: T[Seq[PathRef]] = Task.Sources(customSourceDirs*)

  def sources: T[Seq[PathRef]] = Task {
    (super.sources() ++ customSources()).distinctBy(_.path)
  }
  def externalSources: T[Seq[PathRef]] = Task {
    defaultResolver().classpath(allBoundMvnDeps(), sources = true, artifactTypes = None)(
      using CoursierModule.ResolvableBoundDep
    )
  }
  def repositoriesTask = Task.Anon {
    super.repositoriesTask() ++ Seq(
      coursier.maven.MavenRepository("https://scala-ci.typesafe.com/artifactory/scala-integration")
    )
  }
  override implicit def crossSbtModuleResolver: Cross.Resolver[CrossModuleBase] =
    new Cross.Resolver[CrossModuleBase] {
      def resolve[V <: CrossModuleBase](c: Cross[V]): V = {
        crossScalaVersion
          .split('.')
          .inits
          .filter { v =>
            if (isScala3(crossScalaVersion)) v.length != 2 else v.length != 1
          }
          .flatMap(prefix =>
            c.items
              .map(_.module.apply())
              .find(_.crossScalaVersion.split('.').startsWith(prefix))
          )
          .collectFirst { case x => x }
          .getOrElse {
            throw new Exception(
              s"Unable to find compatible cross version between $crossScalaVersion and " +
                c.items.map(_.module.apply().crossScalaVersion).mkString(",")
            )
          }

      }
    }
}
trait AmmModule extends AmmInternalModule with SonatypeCentralPublishModule with CoursierModule {
  def publishVersion: T[String] = Task { build.publishVersion }
  def publishData: T[mill.javalib.PublishModule.PublishData] = Task {
    mill.javalib.PublishModule.PublishData(artifactMetadata(), publishArtifactsPayload()())
  }
  override def docJar: T[PathRef] = Task { build.emptyDocJar() }
  def pomSettings = PomSettings(
    description = artifactName(),
    organization = "sh.almond.ammonite",
    url = s"https://github.com/${ghOrg}/${ghRepo}",
    licenses = Seq(License.MIT),
    versionControl = VersionControl.github(ghOrg, ghRepo),
    developers = Seq(
      Developer("lihaoyi", "Li Haoyi", "https://github.com/lihaoyi")
    )
  )

  def transitiveJars: T[Seq[PathRef]] = Task {
    Task.traverse(this +: moduleDeps)(m =>
      Task.Anon { m.jar() }
    )()
  }

  def transitiveSourceJars: T[Seq[PathRef]] = Task {
    Task.traverse(this +: moduleDeps)(m =>
      Task.Anon { m.sourceJar() }
    )()
  }

  override def javacOptions: T[Seq[String]] = Task { Seq("--release", "8") }

  def docSources = Task {
    val sv = scalaVersion()
    if (Version(sv) <= Version("2.12.11")) Nil
    else super.docSources()
  }
}
trait AmmDependenciesResourceFileModule extends JavaModule {
  def dependencyResourceFileName: String
  def dependencyFileResources: T[Seq[PathRef]] = Task {
    val deps0 = (compileMvnDeps() ++ allMvnDeps()).map(bindDependency())
    val result = mill.util.Jvm.resolveDependenciesMetadataSafe(
      repositoriesTask(),
      deps0.map(_.dep),
      deps0.filter(_.force).map(_.dep),
      mapDependencies = Some(mapDependencies())
    )

    result match {
      case Result.Success(r) =>
        Seq(PathRef(generateDependenciesFile(
          dependencyResourceFileName,
          r.minDependencies.toSeq
        )))
      case _ => Nil
    }
  }

  def resources: T[Seq[PathRef]] = super.resources() ++ dependencyFileResources()
}

object terminal extends Cross[TerminalModule](binCrossScalaVersions)
trait TerminalModule extends AmmModule {
  def mvnDeps: T[Seq[Dep]] = Task {
    super.mvnDeps() ++ Seq(
      Deps.fansi,
      Deps.sourcecode
    )
  }
  object test extends AmmTests {
    def mvnDeps: T[Seq[Dep]] = super.mvnDeps() ++ Seq(Deps.sourcecode)
  }
}

object amm extends Cross[MainModule](binCrossScalaVersions) {
  object util extends Cross[UtilModule](binCrossScalaVersions)
  trait UtilModule extends AmmModule {
    def moduleDeps: Seq[PublishModule] = Seq()
    def mvnDeps: T[Seq[Dep]] = Task {
      super.mvnDeps() ++ Seq(
        Deps.osLib,
        Deps.typename,
        Deps.scalaCollectionCompat,
        Deps.fansi,
        Deps.pprint
      )
    }
    def compileMvnDeps: T[Seq[Dep]] = super.compileMvnDeps() ++
      (if (isScala3(crossScalaVersion)) Seq.empty[Dep] else Seq(Deps.scalaReflect(scalaVersion())))
  }

  object compiler extends Cross[CompilerModule](fullCrossScalaVersions)
  trait CompilerModule extends AmmModule {
    def supports3 = true
    def moduleDeps: Seq[PublishModule] =
      Seq(amm.util(), amm.repl.api())
    def isCrossFullScalaVersion = true
    def mvnDeps: T[Seq[Dep]] = Task {
      val scalaSpecificDeps =
        if (isScala2())
          Seq(
            Deps.scalaCompiler(scalaVersion()),
            Deps.scalaparse,
            Deps.scalaXml(scalaVersion())
          )
        else
          Seq[Dep](
            mvn"org.scala-lang::scala3-compiler:${scalaVersion()}",
            mvn"org.ow2.asm:asm:9.9.1"
          )
      super.mvnDeps() ++ scalaSpecificDeps ++ Seq(
        Deps.javassist,
        Deps.javaparserCore
      )
    }

    def exposedClassPath: T[Seq[PathRef]] = Task {
      runClasspath() ++
        externalSources() ++
        transitiveJars() ++
        transitiveSourceJars()
    }

    object test extends AmmTests
  }

//  object `test-runner` extends mill.scalalib.SbtModule {
//    def scalaVersion = "2.12.8"
//    def mvnDeps = super.mvnDeps() ++ Seq(
//      mvn"com.lihaoyi::mill-scalalib:${sys.props("MILL_VERSION")}"
//    )
//  }

  object repl extends Cross[ReplModule](binCrossScalaVersions) {

    object api extends Cross[ReplApiModule](binCrossScalaVersions)
    trait ReplApiModule extends AmmModule
        with AmmDependenciesResourceFileModule {
      def dependencyResourceFileName = "amm-dependencies.txt"
      def moduleDeps: Seq[PublishModule] = Seq(amm.util())
      def mvnDeps: T[Seq[Dep]] = super.mvnDeps() ++ Seq(
        Deps.mainargs,
        Deps.geny,
        Deps.coursierInterface
      )

      def constantsSourceDir: T[PathRef] = Task {
        val dir = Task.dest / "src"
        val dest = dir / "Constants.scala"
        val code =
          s"""package ammonite.interp.script
             |
             |/** Build-time constants. Generated by mill. */
             |object Constants {
             |  def semanticDbVersion = "${Deps.semanticDbScalac.dep.versionConstraint.asString}"
             |}
             |""".stripMargin
        os.write(dest, code, createFolders = true)
        PathRef(dir)
      }
      def compileMvnDeps: T[Seq[Dep]] = super.compileMvnDeps() ++ (if (isScala3(crossScalaVersion))
                                                                     Seq.empty[Dep]
                                                                   else Seq(Deps.scalaReflect(
                                                                     scalaVersion()
                                                                   )))

      def generatedSources: T[Seq[PathRef]] = Task {
        Seq(PathRef(generateConstantsFile(build.publishVersion)), constantsSourceDir())
      }

      def exposedClassPath: T[Seq[PathRef]] = Task {
        amm.repl.api().runClasspath() ++
          amm.repl.api().externalSources() ++
          amm.repl.api().transitiveJars() ++
          amm.repl.api().transitiveSourceJars()
      }
    }

  }
  trait ReplModule extends AmmModule {
    def moduleDeps: Seq[PublishModule] = Seq(
      amm.util(),
      amm.repl.api(),
      terminal()
    )
    def mvnDeps: T[Seq[Dep]] = super.mvnDeps() ++ Seq(
      Deps.jlineTerminal,
      Deps.jlineJna,
      Deps.jlineReader,
      Deps.scalaXml(scalaVersion()),
      // from the former amm.runtime
      Deps.classPathUtil,
      Deps.upickle,
      Deps.requests,
      Deps.mainargs,
      Deps.coursierDependencyInterface,
      // from the former amm.interp
      Deps.fastparse
    ) ++ {
      if (isScala3(crossScalaVersion))
        Seq(
          Deps.sourcecode,
          Deps.scalaCollectionCompat
        )
      else
        Nil
    }
    def compileMvnDeps: T[Seq[Dep]] =
      super.compileMvnDeps() ++ (if (isScala3(crossScalaVersion)) Seq.empty[Dep]
                                 else Seq(Deps.scalaReflect(scalaVersion())))

    object test extends Cross[ReplTestModule](fullScalaVersionsFor(crossScalaVersion))
    trait ReplTestModule extends Cross.Module[String]
        with AmmTests with AmmDependenciesResourceFileModule {
      def testModuleName = "test"
      def crossScalaVersion: String = crossValue
      def scalaVersion: T[String] = Task { crossValue }
      def dependencyResourceFileName = "amm-test-dependencies.txt"

      // JavaTests takes its resolution params from the module under test, which forces the
      // Scala version that module was built with. These tests are built with a different one
      // (the module is built once per binary Scala version, its tests once per full one),
      // so force ours back.
      def resolutionParams: Task[coursier.params.ResolutionParams] = Task.Anon {
        val sv = scalaVersion()
        val org = coursier.Organization(mill.javalib.api.JvmWorkerUtil.scalaOrganization(sv))
        super.resolutionParams().addForceVersion0(
          mill.javalib.Lib.scalaArtifacts(sv).toSeq.sorted.map { name =>
            coursier.Module(org, coursier.ModuleName(name), Map.empty) ->
              coursier.version.VersionConstraint(sv)
          }*
        )
      }

      // ScalaTests takes these from the module under test too, which was built with another
      // Scala version - take them from the compiler module for our version instead, it is
      // built with exactly the Scala version we compile these tests with
      def scalaCompilerBridge: T[Option[PathRef]] = amm.compiler(crossValue).scalaCompilerBridge()
      def scalacPluginMvnDeps: T[Seq[Dep]] = amm.compiler(crossValue).scalacPluginMvnDeps()
      def scalacPluginClasspath: T[Seq[PathRef]] = amm.compiler(crossValue).scalacPluginClasspath()
      def scalacOptions: T[Seq[String]] = amm.compiler(crossValue).scalacOptions()
      def jvmVersion: T[String] = amm.compiler(crossValue).jvmVersion()
      // ...and the JVM the compiler runs on: the Scala 3 compiler bridge for recent
      // versions needs a newer JVM than the module under test is built with
      def jvmId = amm.compiler(crossValue).jvmId
      def javaHome = amm.compiler(crossValue).javaHome

      def moduleDeps: Seq[JavaModule] = super.moduleDeps ++ Seq(amm.compiler(crossValue))

      def thinWhitelist: T[PathRef] = Task {
        generateApiWhitelist(
          amm.repl.api().exposedClassPath() ++
            amm.compiler(crossValue).exposedClassPath() ++
            Seq(compile().classes) ++
            defaultResolver().classpath(
              (this.compileMvnDeps() ++ allMvnDeps()).map(bindDependency())
            )(using CoursierModule.ResolvableBoundDep)
        )
      }

      def runClasspath: T[Seq[PathRef]] = Task {
        super.runClasspath() ++ Seq(thinWhitelist())
      }

      def resources: T[Seq[PathRef]] = {
        // Resolve the sources of the module under test's dependencies with our own resolver,
        // rather than reusing ReplModule.this.externalSources(): that one is resolved for the
        // Scala version that module was built with, and source lookups get confused by having
        // two versions of the Scala library sources around
        (super.resources() ++
          ReplModule.this.sources() ++
          defaultResolver().classpath(
            ReplModule.this.allBoundMvnDeps(),
            sources = true,
            artifactTypes = None
          )(using CoursierModule.ResolvableBoundDep) ++
          defaultResolver().classpath(
            mvnDeps().map(bindDependency()),
            sources = true,
            artifactTypes = None
          )(using CoursierModule.ResolvableBoundDep)).distinct
      }
      def mvnDeps: T[Seq[Dep]] = super.mvnDeps() ++ amm.compiler(crossValue).mvnDeps() ++ Seq(
        Deps.scalazCore,
        Deps.coursierVersions(scalaVersion())
      )
    }
  }
}

trait MainModule extends AmmModule {
  def mainClass: T[Option[String]] = Some("ammonite.AmmoniteMain")
  def artifactName = "ammonite"
  def moduleDeps: Seq[PublishModule] = Seq(
    terminal(),
    amm.util(),
    amm.repl.api(),
    amm.repl()
  )

  // No dependency on amm.compiler, neither published nor at run time: it is published for each
  // full Scala version, while we are published for binary Scala versions only. Users add the
  // ammonite-compiler variant matching their own Scala version, and we pick it up via
  // ammonite.compiler.iface.CompilerBuilderFactory. The `shell` module pairs us with one
  // specific compiler to build the launcher and the assembly.

  def runClasspath: T[Seq[PathRef]] =
    super.runClasspath() ++
      terminal().sources() ++
      amm.util().sources() ++
      amm.repl.api().sources() ++
      amm.repl().sources() ++
      sources() ++
      externalSources()

  def thinWhitelist: T[PathRef] = Task {
    generateApiWhitelist(
      amm.repl.api().exposedClassPath() ++
        amm.compiler().exposedClassPath()
    )
  }
  def localClasspath: T[Seq[PathRef]] = Task {
    Seq(thinWhitelist()) ++ super.localClasspath()
  }

  object test extends Cross[MainTestModule](fullScalaVersionsFor(crossScalaVersion))
  trait MainTestModule extends Cross.Module[String] with AmmTests {
    def testModuleName = "test"
    def crossScalaVersion: String = crossValue
    def scalaVersion: T[String] = Task { crossValue }

    // JavaTests takes its resolution params from the module under test, which forces the
    // Scala version that module was built with. These tests are built with a different one
    // (the module is built once per binary Scala version, its tests once per full one),
    // so force ours back.
    def resolutionParams: Task[coursier.params.ResolutionParams] = Task.Anon {
      val sv = scalaVersion()
      val org = coursier.Organization(mill.javalib.api.JvmWorkerUtil.scalaOrganization(sv))
      super.resolutionParams().addForceVersion0(
        mill.javalib.Lib.scalaArtifacts(sv).toSeq.sorted.map { name =>
        coursier.Module(org, coursier.ModuleName(name), Map.empty) ->
          coursier.version.VersionConstraint(sv)
        }*
      )
    }

    // ScalaTests takes these from the module under test too, which was built with another
    // Scala version - take them from the compiler module for our version instead, it is
    // built with exactly the Scala version we compile these tests with
    def scalaCompilerBridge: T[Option[PathRef]] = amm.compiler(crossValue).scalaCompilerBridge()
    def scalacPluginMvnDeps: T[Seq[Dep]] = amm.compiler(crossValue).scalacPluginMvnDeps()
    def scalacPluginClasspath: T[Seq[PathRef]] = amm.compiler(crossValue).scalacPluginClasspath()
    def scalacOptions: T[Seq[String]] = amm.compiler(crossValue).scalacOptions()
    def jvmVersion: T[String] = amm.compiler(crossValue).jvmVersion()
    // ...and the JVM the compiler runs on: the Scala 3 compiler bridge for recent
    // versions needs a newer JVM than the module under test is built with
    def jvmId = amm.compiler(crossValue).jvmId
    def javaHome = amm.compiler(crossValue).javaHome

    def moduleDeps: Seq[JavaModule] =
      super.moduleDeps ++ Seq(amm.compiler(crossValue).test, amm.repl().test(crossValue))
    def mvnDeps: T[Seq[Dep]] = super.mvnDeps() ++ Seq(
      Deps.scalaJava8Compat
    )

    // Some tests run scripts whose arguments default to os.pwd, and check the
    // directory name they end up with - which is the name of the directory this
    // repository was checked out in.
    def forkEnv: T[Map[String, String]] = super.forkEnv() ++ Seq(
      "AMMONITE_REPO_DIR_NAME" -> BuildCtx.workspaceRoot.last
    )

    def thinWhitelist: T[PathRef] = Task {
      generateApiWhitelist(
        amm.repl.api().exposedClassPath() ++
          amm.compiler(crossValue).exposedClassPath() ++
          Seq(amm.repl().test(crossValue).compile().classes, compile().classes) ++
          defaultResolver().classpath((compileMvnDeps() ++ allMvnDeps()).map(bindDependency()))(
            using CoursierModule.ResolvableBoundDep
          )
      )
    }

    // Need to duplicate this from MainModule due to Mill not properly propagating it through
    def runClasspath: T[Seq[PathRef]] =
      Seq(thinWhitelist()) ++
        super.runClasspath() ++
        terminal().sources() ++
        amm.util().sources() ++
        amm.repl.api().sources() ++
        amm.repl().sources() ++
        sources() ++
        externalSources()

  }
}

/**
 * The Ammonite launcher and assembly for one exact Scala version.
 *
 * `amm` is published per binary Scala version, but a launcher has to bundle a compiler for
 * one specific Scala version, so this is built once per full Scala version. Not published.
 */
object shell extends Cross[ShellModule](fullCrossScalaVersions)
trait ShellModule extends AmmInternalModule {
  def moduleDeps: Seq[JavaModule] = Seq(amm())
  def runModuleDeps: Seq[JavaModule] = Seq(amm.compiler(crossScalaVersion))
  def mainClass: T[Option[String]] = Some("ammonite.AmmoniteMain")

  def prependShellScript: T[String] = Task {
    mill.util.Jvm.launcherUniversalScript(
      mainClass().get,
      Seq("$0"),
      Seq("%~dpnx0"),
      // G1 Garbage Collector is awesome https://github.com/lihaoyi/Ammonite/issues/216
      Seq("-Xmx500m", "-XX:+UseG1GC")
    )
  }

  def thinWhitelist: T[PathRef] = Task {
    generateApiWhitelist(
      amm.repl.api().exposedClassPath() ++
        amm.compiler(crossScalaVersion).exposedClassPath()
    )
  }
  def localClasspath: T[Seq[PathRef]] = Task {
    Seq(thinWhitelist()) ++ super.localClasspath()
  }

  def launcher: T[PathRef] = {
    val isWindows = scala.util.Properties.isWin
    if (isWindows)
      Task {
        val mainClass = finalMainClass()
        val cp = runClasspath().map(_.path)
        val jvmOpts = forkArgs()
        val dest = Task.ctx().dest / "run.bat"

        import coursier.launcher.{BootstrapGenerator, ClassLoaderContent, Parameters, Preamble}
        val classLoaderContent = ClassLoaderContent.fromUrls(cp.map(_.toNIO.toUri.toASCIIString))
        val params = Parameters.Bootstrap(Seq(classLoaderContent), mainClass)
          .withPreamble(
            Preamble()
              .withKind(Preamble.Kind.Bat)
              .withJavaOpts(jvmOpts)
          )
        val thread = Thread.currentThread()
        val cl = thread.getContextClassLoader
        try {
          thread.setContextClassLoader(BootstrapGenerator.getClass.getClassLoader)
          BootstrapGenerator.generate(params, dest.toNIO)
        } finally {
          thread.setContextClassLoader(cl)
        }

        PathRef(dest)
      }
    else
      Task {
        super.launcher()
      }
  }

}

def generateApiWhitelist(replApiCp: Seq[PathRef])(implicit ctx: mill.api.TaskCtx.Dest) = {

  val thinClasspathEntries = replApiCp.map(_.path).flatMap { cpRoot =>
    if (os.isFile(cpRoot) && cpRoot.ext == "jar") {
      val zip = new java.util.zip.ZipFile(cpRoot.toIO)
      import scala.jdk.CollectionConverters._
      for (e <- zip.entries().asScala) yield e.getName
    } else if (os.isDir(cpRoot)) {
      for (sub <- os.walk(cpRoot)) yield sub.relativeTo(cpRoot).toString
    } else if (!os.exists(cpRoot)) Nil
    else throw new Exception(cpRoot.toString)
  }
  os.write(
    ctx.dest / "ammonite-api-whitelist.txt",
    thinClasspathEntries
      .flatMap(_.stripSuffix("/").split('/').inits)
      .filter(_.nonEmpty)
      .map(_.mkString("/"))
      .distinct
      .mkString("\n")
  )
  PathRef(ctx.dest)
}

object integration extends Cross[IntegrationModule](fullCrossScalaVersions)
trait IntegrationModule extends AmmInternalModule {
  def moduleDeps: Seq[JavaModule] = Seq(amm(), amm.compiler())
  def mvnDeps: T[Seq[Dep]] = Task {
    super.mvnDeps() ++ (
      if (scalaVersion().startsWith("2.13."))
        Seq(Deps.cask)
      else
        Seq.empty
    )
  }
  object test extends AmmTests {
    def testLauncher: T[String] = Task {
      if (scala.util.Properties.isWin)
        shell(crossScalaVersion).launcher().path.toString
      else
        shell(crossScalaVersion).assembly().path.toString
    }
    def forkEnv: T[Map[String, String]] = super.forkEnv() ++ Seq(
      "AMMONITE_ASSEMBLY" -> testLauncher()
    )
  }
}

/**
 * Selects all cross module instances, that match the given predicate.
 * In Mill 0.11, this can be hopefully replaced with a simple filter on the `crossValue`.
 */
def selectCrossPrefix[T <: mill.Cross.Module[?], V](
    crossModule: Cross[T],
    predicate: String => Boolean
)(accessor: T => V): Seq[V] =
  crossModule.items.collect {
    case item if predicate(item.crossSegments.last) => accessor(item.module.apply())
  }
    .tap { mods =>
      if (mods.isEmpty) sys.error(s"No matching cross-instances found in ${crossModule}")
    }

def unitTest(scalaVersion: String = "")
    : Command[Seq[(msg: String, results: Seq[mill.javalib.testrunner.TestResult])]] = {
  val binPred = (v: String) =>
    v.startsWith(scalaVersion.split("[.\\-]").take(if (v.startsWith("2")) 2 else 1).mkString("."))
  val pred = (_: String).startsWith(scalaVersion)

  // amm and amm.repl are built once per binary Scala version, but their tests are built
  // once per full Scala version, so that they run against each compiler we support
  val replTests: Seq[TestModule] = amm.repl.items
    .map(_.module.apply())
    .filter(m => binPred(m.crossScalaVersion))
    .flatMap(_.test.items.map(_.module.apply()))
    .filter(m => pred(m.crossValue))
  val mainTests: Seq[TestModule] = amm.items
    .map(_.module.apply())
    .filter(m => binPred(m.crossScalaVersion))
    .flatMap(_.test.items.map(_.module.apply()))
    .filter(m => pred(m.crossValue))

  val tests: Seq[TestModule] =
    selectCrossPrefix(terminal, binPred)(_.test) ++ replTests ++ mainTests
  if (tests.isEmpty)
    sys.error(s"No test modules matching Scala version '$scalaVersion'")

  val log = Task.Anon { Task.log.streams.out.println(s"Testing modules: ${tests.mkString(", ")}") }

  Task.Command {
    log()
    Task.traverse(tests)(_.testCached)()
  }
}

def integrationTest(scalaVersion: String = "") = Task.Command {
  Task.traverse(
    selectCrossPrefix(integration, _.startsWith(scalaVersion))(_.test)
  )(_.testCached)()
}

def generateConstantsFile(
    version: String = publishVersion,
    unstableVersion: String = "<fill-me-in-in-Constants.scala>",
    curlUrl: String = "<fill-me-in-in-Constants.scala>",
    unstableCurlUrl: String = "<fill-me-in-in-Constants.scala>",
    oldCurlUrls: Seq[(String, String)] = Nil,
    oldUnstableCurlUrls: Seq[(String, String)] = Nil,
    returnDirectory: Boolean = true
)(implicit ctx: mill.api.TaskCtx.Dest) = {
  val versionTxt = s"""
    package ammonite
    object Constants{
      val version = "$version"
      val unstableVersion = "$unstableVersion"
      val curlUrl = "$curlUrl"
      val unstableCurlUrl = "$unstableCurlUrl"
      val oldCurlUrls = Seq[(String, String)](
        ${oldCurlUrls.map { case (name, value) => s""" "$name" -> "$value" """ }.mkString(",\n")}
      )
      val oldUnstableCurlUrls = Seq[(String, String)](
        ${oldUnstableCurlUrls.map { case (name, value) => s""" "$name" -> "$value" """ }.mkString(
      ",\n"
    )}
      )
    }
  """
  println("Writing Constants.scala")

  val dir = ctx.dest / "src"
  os.write(dir / "Constants.scala", versionTxt, createFolders = true)
  if (returnDirectory) dir
  else dir / "Constants.scala"
}

def generateDependenciesFile(fileName: String, deps: Seq[coursier.Dependency])(implicit
    ctx: mill.api.TaskCtx.Dest
) = {

  val dir = ctx.dest / "extra-resources"
  val dest = dir / fileName

  val content = deps
    .map { dep =>
      (dep.module.organization.value, dep.module.name.value, dep.versionConstraint.asString)
    }
    .sorted
    .map {
      case (org, name, ver) =>
        s"$org:$name:$ver"
    }
    .mkString("\n")

  os.makeDir(dir)
  println(s"Writing $dest")
  dir.toIO.mkdirs()
  os.write(dest, content.getBytes("UTF-8"))

  dir
}

/** Scala versions from `_sv*` tag parts, or `None` to publish every module. */
def publishScalaVersionsFromTag(tag: String): Option[Seq[String]] =
  if (!tag.contains('_')) None
  else {
    val versions = tag.split('_').toSeq.drop(1).collect {
      case part if part.startsWith("sv") => part.stripPrefix("sv")
    }
    if (versions.isEmpty)
      sys.error(s"Tag $tag contains '_' but no sv* Scala version parts")
    Some(versions)
  }

def publishBundleNameFromTag(tag: String): String =
  "ammonite-" + tag.stripPrefix("v").replace('_', '-')

def publishModulesForScalaVersions(versions: Option[Seq[String]]): Seq[AmmModule] = {
  val all = moduleInternal.modules.collect { case m: AmmModule => m }
  val modules = versions match {
    case None => all
    case Some(vs) =>
      val wanted = vs.toSet
      all.filter(m => m.isCrossFullScalaVersion && wanted(m.crossScalaVersion))
  }
  versions.foreach { vs =>
    if (modules.isEmpty)
      sys.error(s"No publishable modules for Scala versions: ${vs.mkString(", ")}")
  }
  modules
}

/**
 * Lists the artifacts a `publishMaven` for `tag` would push, and fails if two modules
 * would be published under the same artifact id.
 *
 * Maven Central asks projects to keep the number of modules they publish in check, hence
 * this. Pass a tag to check a Scala-version-specific bundle, like `v3.0.0_sv2.13.16`.
 */
def publishedArtifacts(tag: String = "") = {
  val tagOpt = Option(tag).filter(_.nonEmpty)
  val modules = publishModulesForScalaVersions(tagOpt.flatMap(publishScalaVersionsFromTag))
  val artifactIdTasks = modules.map(_.artifactId)
  Task.Command {
    val artifactIds = Task.sequence(artifactIdTasks)()

    val duplicates = artifactIds.groupBy(identity).filter(_._2.length > 1).keys.toSeq.sorted
    if (duplicates.nonEmpty)
      sys.error(
        s"Several modules would be published as ${duplicates.mkString(", ")} - " +
          "see AmmInternalModule.isPublishedCrossInstance"
      )

    artifactIds.sorted
  }
}

def publishTag: Option[String] =
  sys.env.get("GITHUB_REF").collect {
    case ref if ref.startsWith("refs/tags/") => ref.stripPrefix("refs/tags/")
  }

def publishMaven(tag: String = "") = {
  val tagOpt = Option(tag).filter(_.nonEmpty).orElse(publishTag)
  val artifacts = Tasks(
    publishModulesForScalaVersions(tagOpt.flatMap(publishScalaVersionsFromTag))
      .map(_.publishData)
  )
  val bundleName = tagOpt.fold("")(publishBundleNameFromTag)
  Task.Command {
    mill.javalib.SonatypeCentralPublishModule.publishAll(
      publishArtifacts = artifacts,
      bundleName = bundleName
    )()
  }
}

def publishExecutable() = Task.Command {
  val latestAssemblyJars = Task.sequence(latestAssemblies)()

  println("MASTER COMMIT: Creating a release")
  if (!isUnstableBuild) {
    requests.post(
      url = s"https://api.github.com/repos/$ghOrg/$ghRepo/releases",
      data = requests.RequestBlob.ByteSourceRequestBlob {
        ujson.write(
          ujson.Obj(
            "tag_name" -> publishVersion,
            "name" -> publishVersion,
            "body" -> s"$homePage/#$publishVersion"
          )
        )
      },
      headers = Seq("Authorization" -> s"token ${sys.env("AMMONITE_BOT_AUTH_TOKEN")}")
    )
  }

  for ((version, jar) <- assemblyCrossScalaVersions.zip(latestAssemblyJars)) {
    println("MASTER COMMIT: Publishing Executable for Scala " + version)
    // Prepare executable

    val scalaBinaryVersion = version.take(version.lastIndexOf("."))
    upload(
      uploadedFile = jar.path,
      tagName = latestTaggedVersion,
      uploadName = s"$scalaBinaryVersion-$publishVersion",
      authKey = sys.env("AMMONITE_BOT_AUTH_TOKEN"),
      ghOrg = ghOrg,
      ghRepo = ghRepo
    )
    upload(
      uploadedFile = os.temp(
        os.read(BuildCtx.workspaceRoot / "amm-template.sh")
          .replace("DEFAULT_AMM_VERSION=", s"DEFAULT_AMM_VERSION=$latestTaggedVersion")
          .replace("DEFAULT_SCALA_VERSION=", s"DEFAULT_SCALA_VERSION=$scalaBinaryVersion")
      ),
      tagName = latestTaggedVersion,
      uploadName = s"$scalaBinaryVersion-$publishVersion-bootstrap",
      authKey = sys.env("AMMONITE_BOT_AUTH_TOKEN"),
      ghOrg = ghOrg,
      ghRepo = ghRepo
    )
  }
}
